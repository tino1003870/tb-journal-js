{
  "manifest_version": 2,
  "name": "TB Journal",
  "version": "0.1.9",
  "description": "CalDAV VJOURNAL journal client.",
  "browser_specific_settings": {
    "gecko": {
      "id": "tb-journal@optocon.de",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "authenticationInfo",
          "websiteContent"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_action": {
    "default_title": "TB Journal öffnen",
    "default_label": "TB Journal"
  },
  "options_ui": {
    "page": "journal.html",
    "open_in_tab": true
  },
  "commands": {
    "open-journal": {
      "suggested_key": {
        "default": "Ctrl+Alt+J"
      },
      "description": "TB Journal öffnen"
    }
  },
  "permissions": [
    "tabs",
    "storage",
    "<all_urls>"
  ]
}
